{
  "name": "livefy-control-center",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "agent:build": "npm --prefix apps/livefy-agent run build",
    "agent:test": "npm --prefix apps/livefy-agent test",
    "agent:start": "npm --prefix apps/livefy-agent start",
    "agent:diagnose": "npm --prefix apps/livefy-agent run diagnose",
    "extension:icons": "node scripts/render-extension-icons.mjs",
    "test:visual": "playwright test",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "@vitejs/plugin-react": "^4.3.4",
    "@xyflow/react": "^12.11.3",
    "gsap": "^3.15.0",
    "iconsax-react": "^0.0.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.185.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@types/three": "^0.185.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^2.1.8"
  }
}
