{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extensionName__",
  "version": "1.3.0",
  "minimum_chrome_version": "116",
  "description": "__MSG_extensionDescription__",
  "permissions": ["storage", "alarms", "sidePanel", "nativeMessaging"],
  "host_permissions": [
    "https://*.tiktok.com/*",
    "https://livefy-tau.vercel.app/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://127.0.0.1/*"],
  "background": {"service_worker": "background.js"},
  "icons": {"16":"icons/icon16.png","32":"icons/icon32.png","48":"icons/icon48.png","128":"icons/icon128.png"},
  "action": {
    "default_title": "Open Livefy controller",
    "default_icon": {"16":"icons/icon16.png","32":"icons/icon32.png"}
  },
  "side_panel": {"default_path":"sidepanel.html"},
  "options_page": "options.html",
  "content_scripts": [{
    "matches": ["https://*.tiktok.com/*"],
    "js": ["shared.js", "content.js"],
    "run_at": "document_idle"
  },{
    "matches": ["https://livefy-tau.vercel.app/*","http://127.0.0.1/*"],
    "js": ["web-bridge.js"],
    "run_at": "document_start"
  }],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
